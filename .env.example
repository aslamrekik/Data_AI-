# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Provedor do extrator: gemini ou claude (padrão: gemini)
PROVEDOR=gemini

# Gemini — chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo usado pelo extrator (confira o nome atual no Google AI Studio)
GEMINI_MODEL=gemini-2.5-flash

# Claude — chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
